classDiagram
    direction TB

    class Proyecto["Proyecto analizado"]
    class Resolucion["Resolución"]
    class Entrada["Entrada de configuración"]
    class Declaracion["Declaración"]
    class Sustitucion["Sustitución"]
    class Elemento["Elemento"]
    class Agente["Agente"]
    class Regla["Regla de permiso"]
    class Hallazgo["Hallazgo"]

    Proyecto --> Resolucion : se resuelve en (1 a 1..*)
    Resolucion --> Entrada : lee (1 a 1..*)
    Entrada --> Declaracion : contiene (1 a 1..*)
    Declaracion --> Sustitucion : contiene (1 a 0..*)
    Declaracion --> Declaracion : desplaza a (0..1 a 0..1)
    Elemento --> Declaracion : se compone de (1 a 0..*)
    Elemento -- Elemento : se relaciona con (* a *, diferida)
    Agente --> Regla : evalúa en cadena ordenada (1 a 1..*)
    Regla --> Declaracion : proviene de (0..* a 0..1)
    Agente --> Agente : invoca (1 a 0..*)
    Resolucion --> Hallazgo : produce (1 a 0..*)
    Hallazgo --> Elemento : recae sobre (* a 0..1)
    Hallazgo --> Declaracion : recae sobre (* a 0..1)
    Hallazgo --> Entrada : recae sobre (* a 0..1)

    Elemento <|-- Agente

    note for Hallazgo "{xor} elemento, declaración o entrada"
    note for Agente "El subagente hereda las
reglas de denegación (RD-05)"
    note for Elemento "A lo sumo una declaración determinante;
sin declaraciones rige el valor implícito (RD-04);
relación entre elementos
diferida (L-12, RF-13)"
