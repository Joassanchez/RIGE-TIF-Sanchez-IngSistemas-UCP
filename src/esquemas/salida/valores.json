{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta valores de RIGE v2",
  "type": "object",
  "properties": {
    "esquema": {
      "const": 2
    },
    "proyecto": {
      "type": "string"
    },
    "entradas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entrada"
      }
    },
    "resumenEntradas": {
      "type": "string"
    },
    "versionRige": {
      "type": "string"
    },
    "herramienta": {
      "type": "string"
    },
    "versionHerramienta": {
      "type": "string"
    },
    "agente": {
      "type": "string"
    },
    "ruta": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "valores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "rastro": {
            "type": "object",
            "properties": {
              "ruta": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "indiceFusion": {
                "type": "integer"
              },
              "valor": {
                "$ref": "#/$defs/Valor"
              },
              "determinante": {
                "$ref": "#/$defs/Declaracion"
              },
              "motivo": {
                "type": "string"
              },
              "desplazadas": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Declaracion"
                }
              }
            },
            "required": [
              "ruta",
              "indiceFusion",
              "valor",
              "determinante",
              "motivo",
              "desplazadas"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "clave",
          "rastro"
        ],
        "additionalProperties": false
      }
    },
    "reglas": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "noResueltas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruta": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regla": {
            "type": "string"
          },
          "sustituciones": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ValorSustituidoUbicado"
            }
          }
        },
        "required": [
          "ruta",
          "regla"
        ],
        "additionalProperties": false
      }
    },
    "motivo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "declaraciones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "esquema",
    "proyecto",
    "entradas",
    "resumenEntradas",
    "versionRige",
    "herramienta",
    "versionHerramienta",
    "agente",
    "ruta",
    "valores",
    "reglas",
    "noResueltas",
    "motivo",
    "declaraciones"
  ],
  "additionalProperties": false,
  "$defs": {
    "Valor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Valor"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Valor"
          }
        }
      ]
    },
    "Origen": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tipo": {
              "const": "declarado"
            },
            "orden": {
              "type": "integer"
            },
            "posicion": {
              "type": "object",
              "properties": {
                "linea": {
                  "type": "integer"
                },
                "columna": {
                  "type": "integer"
                }
              },
              "required": [
                "linea",
                "columna"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tipo",
            "orden",
            "posicion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tipo": {
              "enum": [
                "implicito",
                "nativo"
              ]
            },
            "regla": {
              "type": "string"
            }
          },
          "required": [
            "tipo",
            "regla"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Declaracion": {
      "type": "object",
      "properties": {
        "origen": {
          "$ref": "#/$defs/Origen"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "referencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "valor": {
          "$ref": "#/$defs/Valor"
        },
        "regla": {
          "type": "string"
        },
        "sustituciones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValorSustituido"
          }
        }
      },
      "required": [
        "origen",
        "via",
        "referencia",
        "valor",
        "regla"
      ],
      "additionalProperties": false
    },
    "Entrada": {
      "type": "object",
      "properties": {
        "orden": {
          "type": "integer"
        },
        "via": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        },
        "condicion": {
          "enum": [
            "observada",
            "no_observada",
            "definida"
          ]
        },
        "resumen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "legibilidad": {
          "enum": [
            "legible",
            "ilegible",
            null
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "linea": {
              "type": "integer",
              "minimum": 1
            },
            "columna": {
              "type": "integer",
              "minimum": 1
            },
            "consecuencia": {
              "enum": [
                "falla",
                "descartada"
              ]
            }
          },
          "required": [
            "linea",
            "columna",
            "consecuencia"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orden",
        "via",
        "referencia",
        "condicion",
        "resumen"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "legibilidad": {
                "const": "ilegible"
              }
            },
            "required": [
              "legibilidad"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "ValorSustituido": {
      "type": "object",
      "properties": {
        "tipo": {
          "enum": [
            "variable",
            "archivo"
          ]
        },
        "origen": {
          "type": "string"
        },
        "definido": {
          "type": "boolean"
        },
        "posicion": {
          "type": "object",
          "properties": {
            "linea": {
              "type": "integer"
            },
            "columna": {
              "type": "integer"
            }
          },
          "required": [
            "linea",
            "columna"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tipo",
        "origen",
        "definido",
        "posicion"
      ],
      "additionalProperties": false
    },
    "ValorSustituidoUbicado": {
      "type": "object",
      "properties": {
        "tipo": {
          "enum": [
            "variable",
            "archivo"
          ]
        },
        "origen": {
          "type": "string"
        },
        "definido": {
          "type": "boolean"
        },
        "posicion": {
          "type": "object",
          "properties": {
            "linea": {
              "type": "integer"
            },
            "columna": {
              "type": "integer"
            }
          },
          "required": [
            "linea",
            "columna"
          ],
          "additionalProperties": false
        },
        "orden": {
          "type": "integer"
        },
        "referencia": {
          "type": "string"
        }
      },
      "required": [
        "tipo",
        "origen",
        "definido",
        "posicion",
        "orden",
        "referencia"
      ],
      "additionalProperties": false
    }
  }
}
