{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta hallazgos de RIGE v2",
  "type": "object",
  "properties": {
    "esquema": {
      "const": 2
    },
    "proyecto": {
      "type": "string"
    },
    "resumenEntradas": {
      "type": "string"
    },
    "declaraciones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reglas": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entradas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entrada"
      }
    },
    "incompleta": {
      "type": "boolean"
    },
    "motivos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hallazgo"
      }
    },
    "resumen": {
      "type": "object",
      "properties": {
        "elementos": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "agentes": {
                  "type": "integer",
                  "minimum": 0
                },
                "comandos": {
                  "type": "integer",
                  "minimum": 0
                },
                "entradas": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "agentes",
                "comandos",
                "entradas"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "hallazgos": {
          "type": "object",
          "properties": {
            "entrada-ilegible": {
              "type": "integer",
              "minimum": 0
            },
            "entrada-descartada": {
              "type": "integer",
              "minimum": 0
            },
            "sustitucion-sin-valor": {
              "type": "integer",
              "minimum": 0
            },
            "referencia-no-resuelta": {
              "type": "integer",
              "minimum": 0
            },
            "regla-sin-efecto": {
              "type": "integer",
              "minimum": 0
            },
            "elemento-sin-uso": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "entrada-ilegible",
            "entrada-descartada",
            "sustitucion-sin-valor",
            "referencia-no-resuelta",
            "regla-sin-efecto",
            "elemento-sin-uso"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "elementos",
        "hallazgos"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "esquema",
    "proyecto",
    "resumenEntradas",
    "declaraciones",
    "reglas",
    "entradas",
    "incompleta",
    "motivos",
    "hallazgos",
    "resumen"
  ],
  "additionalProperties": false,
  "$defs": {
    "Entrada": {
      "type": "object",
      "properties": {
        "orden": {
          "type": "integer"
        },
        "via": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        },
        "condicion": {
          "enum": [
            "observada",
            "no_observada",
            "definida"
          ]
        },
        "resumen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "legibilidad": {
          "enum": [
            "legible",
            "ilegible",
            null
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "linea": {
              "type": "integer",
              "minimum": 1
            },
            "columna": {
              "type": "integer",
              "minimum": 1
            },
            "consecuencia": {
              "enum": [
                "falla",
                "descartada"
              ]
            }
          },
          "required": [
            "linea",
            "columna",
            "consecuencia"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orden",
        "via",
        "referencia",
        "condicion",
        "resumen"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "legibilidad": {
                "const": "ilegible"
              }
            },
            "required": [
              "legibilidad"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "Hallazgo": {
      "type": "object",
      "properties": {
        "tipo": {
          "enum": [
            "entrada-ilegible",
            "entrada-descartada",
            "sustitucion-sin-valor",
            "referencia-no-resuelta",
            "regla-sin-efecto",
            "elemento-sin-uso"
          ]
        },
        "causa": {
          "type": "string"
        },
        "entrada": {
          "type": "object",
          "properties": {
            "orden": {
              "type": "integer"
            },
            "via": {
              "type": "string"
            },
            "referencia": {
              "type": "string"
            },
            "condicion": {
              "enum": [
                "observada",
                "definida"
              ]
            }
          },
          "required": [
            "orden",
            "via",
            "referencia",
            "condicion"
          ],
          "additionalProperties": false
        },
        "posicion": {
          "type": "object",
          "properties": {
            "linea": {
              "type": "integer",
              "minimum": 1
            },
            "columna": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "linea",
            "columna"
          ],
          "additionalProperties": false
        },
        "clave": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "parametros": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "localizacion": {
          "type": "string"
        },
        "explicacion": {
          "type": "string"
        }
      },
      "required": [
        "tipo",
        "causa",
        "entrada",
        "posicion",
        "clave",
        "parametros",
        "localizacion"
      ],
      "additionalProperties": false
    }
  }
}
