{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta error de RIGE v2",
  "type": "object",
  "properties": {
    "esquema": {
      "const": 2
    },
    "error": {
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string"
        },
        "mensaje": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        }
      },
      "required": [
        "codigo",
        "mensaje"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "esquema",
    "error"
  ],
  "additionalProperties": false
}
