RIGE_PUERTO=4747
RIGE_ALMACEN=

# Solo las dos asignaciones anteriores se admiten en rige.env.
# Las siguientes son variables de consola: NO quitar el comentario aqui.
# Hogar y ubicaciones; ejemplos ilustrativos para una copia temporal de demostracion.
# HOME=/tmp/rige-demo/hogar                  # Hogar en Linux.
# USERPROFILE=C:/Temp/rige-demo/hogar        # Hogar en Windows.
# LOCALAPPDATA=C:/Temp/rige-demo/datos       # Base del almacen Windows.
# XDG_CONFIG_HOME=/tmp/rige-demo/hogar/.config # Configuracion global analizada.
# XDG_DATA_HOME=/tmp/rige-demo/datos         # Datos y base del almacen Linux.
# TEMP=C:/Temp/rige-demo/tmp                # Temporales, primera opcion Windows.
# TMP=/tmp/rige-demo/tmp                    # Alternativa de temporales.
# TMPDIR=/tmp/rige-demo/tmp                 # Primera opcion Linux.
# SystemRoot=C:/Windows                    # Sistema y alternativa de temporales Windows.
# PATH=/usr/bin                            # Busqueda de git y primer opencode.
# Path=C:/Windows/System32                 # Variante Windows si PATH no existe.
# PATHEXT=.COM;.EXE;.BAT;.CMD               # Extensiones de ejecutables Windows.
# ProgramData=C:/ProgramData               # Via administrada, no observada.

# Entradas de OpenCode: se establecen en consola, nunca en rige.env.
# OPENCODE_CONFIG=/tmp/rige-demo/externa/config.json # Archivo absoluto.
# OPENCODE_CONFIG_DIR=/tmp/rige-demo/dir-variable # Directorio absoluto canonico.
# OPENCODE_CONFIG_CONTENT={"agent":{}}     # Entrada JSONC, no se conserva el texto crudo.
# OPENCODE_PERMISSION={"read":"ask"}     # Entrada JSON estricto.
# OPENCODE_DISABLE_PROJECT_CONFIG=true     # via-no-soportada con true o 1.
# OPENCODE_TEST_HOME=/tmp/rige-demo/hogar   # via-no-soportada si esta definida.
# OPENCODE_TEST_MANAGED_CONFIG_DIR=/tmp/rige-demo/gestion # via-no-soportada si no vacia.

# Git: cualquiera definida, incluso vacia, produce via-no-soportada.
# GIT_DIR=/tmp/rige-demo/.git               # Directorio Git alternativo.
# GIT_WORK_TREE=/tmp/rige-demo/proyecto     # Arbol alternativo.
# GIT_CEILING_DIRECTORIES=/tmp              # Limite de descubrimiento.
# GIT_COMMON_DIR=/tmp/rige-demo/comun       # Directorio comun.

# Lectura dinamica {env:NOMBRE}: cualquier nombre declarado por la configuracion.
# NOMBRE=valor-de-prueba                    # Solo origen y condicion en la salida.

# Variables del arnes, no opciones del producto.
# APPDATA=C:/Temp/rige-demo/hogar           # Aislamiento de referencias nativas.
# XDG_STATE_HOME=/tmp/rige-demo/hogar       # Aislamiento del arnes.
# XDG_CACHE_HOME=/tmp/rige-demo/hogar       # Aislamiento del arnes.
# OPENCODE_DISABLE_EXTERNAL_SKILLS=true    # Solo captura nativa que lo declare.
# RNF07_ESTRICTO=1                         # Exige menos de 2000 ms en medir:rnf07.
